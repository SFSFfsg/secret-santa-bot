# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-your-token

# Название компании в приветствии
COMPANY_NAME=NF Group

# Путь к базе SQLite
DB_PATH=data/santa.db

# Telegram ID тех, кто может создавать игры (через запятую).
# Пусто — создавать игры может любой.
ADMIN_IDS=

# Часовой пояс для дат и напоминаний
TZ_NAME=Europe/Moscow
# Во сколько (час) присылать напоминания
REMINDER_HOUR=11

# Фирменные цвета (можно подставить точные значения из брендбука)
# BRAND_NAVY=#13213A
# BRAND_BEIGE=#E6DCCB
# BRAND_RED=#C8102E
